# sfg configuration surface. Copy to /etc/sfg/sfg.env (root:dev, 0640) and
# fill in. Nothing secret belongs in git. Everything the business may change
# without a deploy is NOT here: it is in the CMS → Parameters.

SFG_ENV=development                      # production enables HSTS, release mode, refuses seed-dev / migrate down
SFG_HTTP_ADDR=127.0.0.1:8098             # loopback only; nginx is the way in
SFG_PUBLIC_BASE_URL=https://sunshinefacility.sunshinefood.co.id   # canonical URLs, link previews, email links
SFG_TRUSTED_PROXIES=127.0.0.1            # nginx, so the client IP is the visitor's

SFG_DATABASE_URL=postgres://sfg_app:CHANGE_ME@127.0.0.1:5432/sfg?sslmode=disable
SFG_TEST_DATABASE_URL=postgres://sfg_app:CHANGE_ME@127.0.0.1:5432/sfg_test?sslmode=disable

SFG_JWT_SECRET=                          # 32+ random characters: openssl rand -hex 32
SFG_ACCESS_TOKEN_TTL=15m
SFG_REFRESH_TOKEN_TTL=168h
SFG_SETUP_TOKEN=                         # enables first-run setup until the first superadmin exists

SFG_SMTP_HOST=127.0.0.1                  # mailpit in development; the relay in production
SFG_SMTP_PORT=1025
SFG_SMTP_USER=
SFG_SMTP_PASSWORD=
SFG_NOTIFY_ENABLED=true                  # false = log instead of sending

SFG_S3_ENDPOINT=127.0.0.1:9012           # MinIO
SFG_S3_ACCESS_KEY=sfg
SFG_S3_SECRET_KEY=
SFG_S3_BUCKET=sfg
SFG_S3_USE_SSL=false

SFG_LOG_LEVEL=info

# Development only — `make seed-dev`. Never set these in production.
SFG_DEV_ADMIN_EMAIL=admin@sfg.local
SFG_DEV_ADMIN_PASSWORD=
