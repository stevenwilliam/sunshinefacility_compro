[Unit]
Description=sfg — daily job: certificate-reminders
After=postgresql.service

[Service]
Type=oneshot
User=dev
WorkingDirectory=/home/dev/projects/sfg
EnvironmentFile=/etc/sfg/sfg.env
ExecStart=/home/dev/projects/sfg/bin/sfg job certificate-reminders
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
SyslogIdentifier=sfg-certificate-reminders
