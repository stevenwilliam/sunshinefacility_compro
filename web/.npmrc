# npm 10.8/10.9 crashes resolving an optional peer of the build tool chain
# ("Cannot read properties of null (reading 'edgesOut')", arborist
# #loadPeerSet). Every peer this app needs (react, react-dom) is listed
# explicitly in package.json, so skipping automatic peer installation loses
# nothing. Remove this line once the system npm is upgraded and `npm install`
# succeeds without it.
legacy-peer-deps=true
